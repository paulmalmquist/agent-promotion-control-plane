# Local demo defaults require no external credentials.
POSTGRES_DB=promotion_control_plane
POSTGRES_USER=promotion
POSTGRES_PASSWORD=promotion
# Host-side API, worker, and CLI override. Compose supplies its own internal URL.
DATABASE_URL=postgresql+psycopg://promotion:promotion@localhost:5433/promotion_control_plane
STARTUP_BOOTSTRAP=true
DEMO_MODE=true
# Host-side Next.js override. Compose supplies http://api:8000.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=/api
OPENAI_EVAL_MODEL=gpt-5-mini
# OPENAI_API_KEY=
